# ---- Required ----
# Long random string. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=
# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SERVER_URL=https://oleholeh.example.id

# ---- Database ----
# Local SQLite file (default, used by Docker). For Turso: libsql://<db>.turso.io
DATABASE_URI=file:./data/site.db
# Only for Turso
DATABASE_AUTH_TOKEN=

# ---- Deployment (docker-compose) ----
# Domain Caddy requests an HTTPS certificate for
DOMAIN=oleholeh.example.id
# Image to run in production (built by GitHub Actions)
IMAGE=ghcr.io/your-github-user/oleh-oleh-cms:latest

# ---- First-time seed only ----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
