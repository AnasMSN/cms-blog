# Automatic HTTPS (Let's Encrypt) for the domain in .env
{$DOMAIN} {
	encode zstd gzip

	# Uploaded images never change once written: cache them hard.
	@media path /api/media/file/*
	header @media Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy app:3000
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
